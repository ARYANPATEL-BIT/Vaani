# .gitignore — files that must never enter version control.
# Rationale lives in docs/learning/01-repo-setup.md.

# --- Secrets: real environment files, but keep the committed template ---
.env
.env.*
!.env.example

# --- Python bytecode and build artifacts ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Virtual environments (uv creates .venv) ---
.venv/
venv/
env/

# --- Tool caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- OS clutter ---
.DS_Store
Thumbs.db
desktop.ini

.claude/settings.local.json
# --- The session and turn database (vaani/db.py): user transcripts, never commit ---
backend/data/

# --- Downloaded model weights (fetched by backend/scripts/fetch_models.py) ---
# The small Silero VAD model is committed; voices are 60+ MB and are not.
backend/models/*.onnx
!backend/models/silero_vad.onnx
