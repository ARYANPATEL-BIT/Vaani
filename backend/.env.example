# .env.example — the NAMES of environment variables the backend understands.
#
# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed. This template carries names only, never values.
#
# All backend variables are prefixed VAANI_ so they cannot collide with other
# programs' environment variables.

# Application secret key. This is an example of a secret loaded from the
# environment; no feature depends on it yet. Leave blank if unused.
VAANI_SECRET_KEY=
