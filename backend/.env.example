# .env.example — the NAMES of environment variables the backend understands.
#
# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed. This template carries names only, never values.
#
# All backend variables are prefixed VAANI_ so they cannot collide with other
# programs' environment variables.

# Application secret key. This is an example of a secret loaded from the
# environment; no feature depends on it yet. Leave blank if unused.
VAANI_SECRET_KEY=

# Google Gemini API key, used by vaani/providers/gemini.py. Sent only in the
# x-goog-api-key request header; never logged, never in config.toml.
VAANI_GEMINI_API_KEY=

# Groq API key, used by vaani/providers/groq.py and, with [asr] engine =
# "groq", by vaani/asr/groq.py (speech to text): one key for both. Sent only
# in the Authorization: Bearer request header; never logged, never in
# config.toml. Required if "groq" is in [llm] provider_order, or if
# [asr] engine is "groq".
VAANI_GROQ_API_KEY=

# --- Speech recognition ([asr] in config.toml) -------------------------------
# Leave commented to use config.toml.
#
# "groq": transcribe on Groq's servers (no GPU needed; every turn's audio is
# uploaded to Groq). "faster-whisper": local, the committed default.
# VAANI_ASR__ENGINE=groq
#
# Forced language and prompt, for both engines. These were
# VAANI_ASR__WHISPER__LANGUAGE / VAANI_ASR__WHISPER__INITIAL_PROMPT before
# feat/groq-stt; the old names now stop the server starting.
# VAANI_ASR__LANGUAGE=hi
# VAANI_ASR__INITIAL_PROMPT=

# --- Google sign-in ([auth] in config.toml, vaani/auth.py) -------------------
# With [auth] enabled = true (the committed default) the server refuses to
# start until the first three are set. Setup steps: docs/learning/
# backend-learning/22-google-auth.md, "Set up auth locally".

# OAuth 2.0 Web client ID from Google Cloud Console (APIs & Services >
# Credentials). The same value goes in frontend/.env.local as
# VITE_GOOGLE_CLIENT_ID. Google ID tokens must be issued for exactly this ID.
VAANI_AUTH__GOOGLE_CLIENT_ID=

# Key that signs the vaani_session cookie (HMAC-SHA256). At least 32
# characters. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it signs every user out.
VAANI_AUTH__SESSION_SECRET=

# The only Google accounts allowed in, as a JSON list (case does not matter):
#   VAANI_AUTH__ALLOWED_EMAILS=["you@gmail.com", "teammate@gmail.com"]
# Real addresses live here, never in config.toml. [] lets nobody in (and
# stops the server starting while auth is enabled).
VAANI_AUTH__ALLOWED_EMAILS=[]
# true: any verified Google account gets in (the list above may be [] then).
# VAANI_AUTH__ALLOW_ALL_EMAILS=true

# Overrides of config.toml's [auth] values. Leave commented to use config.toml.
# An empty value (e.g. "VAANI_AUTH__ENABLED=") is an error, not "unset".
#
# false = no sign-in at all, every socket accepted (offline dev, scripts).
# VAANI_AUTH__ENABLED=false
# Browser origins allowed to sign in and open /ws/session (JSON list).
# VAANI_AUTH__ALLOWED_ORIGINS=["http://localhost:5173"]
# true behind HTTPS: the cookie is then sent over HTTPS only.
# VAANI_AUTH__SECURE_COOKIE=true
# Days a sign-in lasts.
# VAANI_AUTH__COOKIE_DAYS=7
# Seconds of clock difference with Google tolerated on token times.
# VAANI_AUTH__CLOCK_SKEW_S=10
# Seconds a sign-in waits for Google's certificates.
# VAANI_AUTH__GOOGLE_TIMEOUT_S=5.0

# --- Voice studio (studio/, feat/voice-studio) ---------------------------------
# The studio is its own process, but it reads THIS file too: the same [auth]
# values above (it checks the same vaani_session cookie with the same secret),
# plus its own VAANI_STUDIO__* overrides of studio/config.toml. The backend
# ignores the VAANI_STUDIO__ keys.
#
# The committed default is CPU. On a machine with an NVIDIA GPU:
# VAANI_STUDIO__DEVICE=cuda
