# Frontend environment variables.
# Copy this to .env.local and fill in values as needed.
# .env.local is gitignored and never committed.

# Where the dev server's proxy sends /auth, /health and /ws (vite.config.js).
# Optional: the default is http://localhost:8000. No VITE_ prefix on purpose:
# only the dev server reads it; it is never put into the browser's code.
# The browser itself uses relative URLs (same origin as the page).
# VAANI_PROXY_TARGET=http://localhost:8000

# Google OAuth client ID for the /login button (src/login/GoogleButton.jsx).
# Must equal the backend's VAANI_AUTH__GOOGLE_CLIENT_ID. Public, not a secret.
# Empty: /login shows a "sign-in is not set up" message instead of the button.
VITE_GOOGLE_CLIENT_ID=
